# PostgreSQL
POSTGRES_USER=huzaflix
POSTGRES_PASSWORD=huzaflix
POSTGRES_DB=huzaflix_dev_api
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# App
NODE_ENV=production
APP_PORT=3000
DB_HOST=postgres
THROTTLER_TTL=60000
THROTTLER_LIMIT=100
CACHE_TTL=60000
JWT_SECRET=huzaflix_jwt_secret
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=huzaflixadmin
MINIO_SECRET_KEY=MinI0SecureP@ss2025!
MINIO_BUCKET_NAME=huzaflix-openapi
SERVER_HOST=your-domain.com

# Audit log uptime (for API cards)
AUDIT_LOG_SERVICE_URL=http://audit-log-service:3000
AUDIT_LOG_TIMEOUT_MS=1500


# Google OAuth (set these for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback
ENABLE_GOOGLE_OAUTH=false
