# PostgreSQL
POSTGRES_USER=huzaflix
POSTGRES_PASSWORD=huzaflix
POSTGRES_DB=huzaflix_dev
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# App
NODE_ENV=production
APP_PORT=3000
DB_HOST=postgres
SERVER_HOST=your-domain.com
USER_SERVICE_PORT=3000
ANALYTICS_SERVICE_PORT=3000
API_MANAGEMENT_SERVICE_PORT=3000
PAYMENT_SERVICE_PORT=3000
AUDIT_LOG_SERVICE_PORT=3000

# Google OAuth (set these for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback
ENABLE_GOOGLE_OAUTH=false

# Audit log dispatch (gateway -> audit-log-service)
AUDIT_LOG_SERVICE_URL=http://audit-log-service:3000
AUDIT_LOG_INGEST_KEY=
