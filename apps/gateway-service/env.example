# PostgreSQL
POSTGRES_USER=huzaflix
POSTGRES_PASSWORD=huzaflix
POSTGRES_DB=huzaflix_dev
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# App
NODE_ENV=production
APP_PORT=3000
DB_HOST=postgres
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
CACHE_TTL=60
JWT_SECRET=huzaflix_jwt_secret
REDIS_URL=redis://redis:${REDIS_PORT}
SERVER_HOST=api.huzaflix.com

# Google OAuth (set these for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.huzaflix.com/auth/google/callback
ENABLE_GOOGLE_OAUTH=false

# Audit log dispatch (gateway -> audit-log-service)
AUDIT_LOG_SERVICE_URL=http://audit-log-service:3000
AUDIT_LOG_INGEST_KEY=
